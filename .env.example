# Postgres. If omitted, local development uses embedded PGlite in .data/pglite.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mingri_menu

# Optional for embedded PGlite. A relative path is resolved from this project.
PGLITE_PATH=.data/pglite

# Fixed server-side family id. Never accepted from the browser.
FAMILY_ID=family_chen
FAMILY_NAME=陈家餐桌
FAMILY_TIMEZONE=Asia/Shanghai

# OpenAI-compatible server-side AI. Leave blank to use local recommendations.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=30000
AI_MAX_DAILY_CALLS=30
AI_MAX_CALLS_PER_IP_PER_DAY=10

# Salt used when hashing client IPs for rate limiting. Set a private random value in production.
IP_HASH_SALT=change-me

# Daily limits for all write APIs, including menu edits, settings and imports.
WRITE_MAX_DAILY_CALLS=500
WRITE_MAX_CALLS_PER_IP_PER_DAY=200

# Seed a few recent dinners on first startup (true/false).
SEED_DEMO_HISTORY=true
